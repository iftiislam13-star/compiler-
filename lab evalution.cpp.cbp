#include <iostream>
#include <string>
#include <set>
#include <cctype>
using namespace std;

set<string> keywords = {
    "int", "float", "double", "char", "bool", "void",
    "if", "else", "while", "for", "do", "return",
    "break", "continue", "switch", "case", "default",
    "long", "short", "const", "static", "class",
    "public", "private", "using", "namespace",
    "include", "endl"
};

set<string> operators = {
    "=", "+", "-", "*", "/", "%",
    "==", "!=", "<", ">", "<=", ">=",
    "&&", "||", "!",
    "++", "--",
    "+=", "-=", "*=", "/=", "%=",
    "<<", ">>",
    "&", "|", "^", "~",
    "&=", "|=", "^=",
    "->", "::", ".", "?", ":"
};

set<string> separators = {
    ";", ",", "{", "}", "(", ")",
    "[", "]"
};

string getType(string word) {

    if (keywords.count(word))
        return "Keyword";

    if (operators.count(word))
        return "Operator";

    if (separators.count(word))
        return "Separator";

    if (word[0] == '"')
        return "String Constant";

    if (word[0] == '\'')
        return "Character Constant";

    if (isdigit(word[0]))
        return "Constant";

    return "Identifier";
}

void lexer(string code) {

    int i = 0;
    int n = code.length();

    cout << "\n========== LEXICAL ANALYZER ==========\n";
    cout << "TOKEN\t\tTYPE\n";
    cout << "--------------------------------------\n";

    while (i < n) {

        if (isspace(code[i])) {
            i++;
            continue;
        }

        // Single line comment
        if (code[i] == '/' && i + 1 < n &&
            code[i + 1] == '/') {

            while (i < n && code[i] != '\n')
                i++;

            continue;
        }

        // Multi-line comment
        if (code[i] == '/' && i + 1 < n &&
            code[i + 1] == '*') {

            i += 2;

            while (i + 1 < n &&
                   !(code[i] == '*' && code[i + 1] == '/'))
                i++;

            i += 2;
            continue;
        }

        string word = "";

        // Keyword or Identifier
        if (isalpha(code[i]) || code[i] == '_') {

            while (i < n &&
                   (isalnum(code[i]) || code[i] == '_')) {

                word += code[i];
                i++;
            }
        }

        // Number / Constant
        else if (isdigit(code[i])) {

            while (i < n &&
                   (isalnum(code[i]) || code[i] == '.' ||
                    code[i] == '_')) {

                word += code[i];
                i++;
            }
        }

        // String Constant
        else if (code[i] == '"') {

            word += code[i++];

            while (i < n) {

                word += code[i];

                if (code[i] == '"') {
                    i++;
                    break;
                }

                if (code[i] == '\\' && i + 1 < n) {
                    i++;
                    word += code[i];
                }

                i++;
            }
        }

        // Character Constant
        else if (code[i] == '\'') {

            word += code[i++];

            while (i < n) {

                word += code[i];

                if (code[i] == '\'') {
                    i++;
                    break;
                }

                if (code[i] == '\\' && i + 1 < n) {
                    i++;
                    word += code[i];
                }

                i++;
            }
        }

        // Operators and Separators
        else {

            bool found = false;

            // Three character operator
            if (i + 2 < n) {

                string three = code.substr(i, 3);

                if (operators.count(three)) {
                    word = three;
                    i += 3;
                    found = true;
                }
            }

            // Two character operator
            if (!found && i + 1 < n) {

                string two = code.substr(i, 2);

                if (operators.count(two)) {
                    word = two;
                    i += 2;
                    found = true;
                }
            }

            // One character operator or separator
            if (!found) {

                string one = code.substr(i, 1);

                if (operators.count(one) ||
                    separators.count(one)) {

                    word = one;
                    i++;
                    found = true;
                }
            }

            if (!found) {
                word = code.substr(i, 1);
                i++;
            }
        }

        if (!word.empty()) {

            cout << word << "\t\t"
                 << getType(word) << endl;
        }
    }

    cout << "--------------------------------------\n";
    cout << "Lexical Analysis Completed!\n";
}

int main() {

    string code;
    string line;

    cout << "Enter C++ Code:\n";
    cout << "(Write END in a separate line to finish)\n\n";

    while (getline(cin, line)) {

        if (line == "END")
            break;

        code += line + "\n";
    }

    lexer(code);

    return 0;
}



