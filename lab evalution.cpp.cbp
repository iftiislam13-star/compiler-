#include <iostream>
#include <fstream>
#include <string>
#include <set>
#include <cctype>
using namespace std;

set<string> keywords = {
    "int", "float", "double", "char", "bool", "void",
    "if", "else", "while", "for", "do", "return",
    "break", "continue", "switch", "case", "default",
    "long", "short", "const", "static", "class",
    "public", "private", "using", "namespace",
    "include", "endl"
};

set<string> operators = {
    "=", "+", "-", "*", "/", "%",

    "==", "!=", "<", ">", "<=", ">=",

    "&&", "||", "!",

    "++", "--",

    "+=", "-=", "*=", "/=", "%=",

    "<<", ">>",

    "&", "|", "^", "~",

    "&=", "|=", "^=",

    "->", "::", ".", "?", ":"
};

set<string> separators = {
    ";", ",", "{", "}", "(", ")",
    "[", "]"
};

string getType(string word) {

    if (keywords.count(word))
        return "keyword";

    if (operators.count(word))
        return "operator";

    if (separators.count(word))
        return "separator";

    if (word[0] == '"')
        return "string constant";

    if (word[0] == '\'')
        return "character constant";

    if (isdigit(word[0]))
        return "constant";

    return "identifier";
}

void lexer() {

    ifstream file("token.txt");

    if (!file) {
        cout << "Cannot open token.txt" << endl;
        return;
    }

    string code(
        (istreambuf_iterator<char>(file)),
        istreambuf_iterator<char>()
    );

    int i = 0;
    int n = code.length();

    cout << "\n========== LEXICAL ANALYSIS ==========\n";
    cout << "Token\t\tType\n";
    cout << "--------------------------------------\n";

    while (i < n) {

        // Ignore spaces and new lines
        if (isspace(code[i])) {
            i++;
            continue;
        }

        // Ignore single line comments
        if (code[i] == '/' && i + 1 < n &&
            code[i + 1] == '/') {

            while (i < n && code[i] != '\n')
                i++;

            continue;
        }

        // Ignore multi-line comments
        if (code[i] == '/' && i + 1 < n &&
            code[i + 1] == '*') {

            i += 2;

            while (i + 1 < n &&
                   !(code[i] == '*' && code[i + 1] == '/')) {
                i++;
            }

            i += 2;
            continue;
        }

        string word = "";

        // Identify identifiers and keywords
        if (isalpha(code[i]) || code[i] == '_') {

            while (i < n &&
                   (isalnum(code[i]) || code[i] == '_')) {

                word += code[i];
                i++;
            }
        }

        // Identify numbers
        else if (isdigit(code[i])) {

            while (i < n &&
                   (isalnum(code[i]) ||
                    code[i] == '.' ||
                    code[i] == '_')) {

                word += code[i];
                i++;
            }
        }

        // Identify string constants
        else if (code[i] == '"') {

            word += code[i++];

            while (i < n) {

                word += code[i];

                if (code[i] == '"' && word.size() > 1) {
                    i++;
                    break;
                }

                if (code[i] == '\\' && i + 1 < n) {
                    i++;
                    word += code[i];
                }

                i++;
            }
        }

        // Identify character constants
        else if (code[i] == '\'') {

            word += code[i++];

            while (i < n) {

                word += code[i];

                if (code[i] == '\'') {
                    i++;
                    break;
                }

                if (code[i] == '\\' && i + 1 < n) {
                    i++;
                    word += code[i];
                }

                i++;
            }
        }

        // Identify operators and separators
        else {

            bool found = false;

            // Check 3-character operators first
            if (i + 2 < n) {

                string three = code.substr(i, 3);

                if (operators.count(three)) {
                    word = three;
                    i += 3;
                    found = true;
                }
            }

            // Check 2-character operators
            if (!found && i + 1 < n) {

                string two = code.substr(i, 2);

                if (operators.count(two)) {
                    word = two;
                    i += 2;
                    found = true;
                }
            }

            // Check 1-character operators
            if (!found) {

                string one = code.substr(i, 1);

                if (operators.count(one) ||
                    separators.count(one)) {

                    word = one;
                    i++;
                    found = true;
                }
            }

            if (!found) {
                word = code.substr(i, 1);
                i++;
            }
        }

        if (!word.empty()) {

            cout << word << "\t\t"
                 << getType(word) << endl;
        }
    }

    cout << "--------------------------------------\n";
    cout << "Lexical Analysis Completed!\n";
}

int main() {

    lexer();

    return 0;
}
